
# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_HOST:5432/YOUR_DATABASE?sslmode=require
SPRING_DATASOURCE_USERNAME=YOUR_USERNAME
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD

# Backend
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
AUTH_SUCCESS_URL=http://localhost:5173/auth/callback
SESSION_COOKIE_SECURE=false

# Google OAuth 2.0 (register the callback URL as http://localhost:8080/login/oauth2/code/google locally)
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}

# Integrations
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:5173/checkout/return
PAYPAL_CANCEL_URL=http://localhost:5173/checkout/cancel
AI_API_KEY=
