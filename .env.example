
# Local PostgreSQL (Docker Compose maps the internal postgres hostname for the backend)
POSTGRES_DB=spendwise
POSTGRES_USER=spendwise
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

# Used when running the backend directly on the host; Compose overrides the URL to use its postgres service.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/spendwise
SPRING_DATASOURCE_USERNAME=spendwise
SPRING_DATASOURCE_PASSWORD=change-me-for-local-development

# Backend
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
AUTH_SUCCESS_URL=http://localhost:3000/auth/callback
SESSION_COOKIE_SECURE=false

# Google OAuth 2.0 (register the callback URL as http://localhost:8080/login/oauth2/code/google locally)
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}

# Integrations
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com
CHANNEL3_SEARCH_LIMIT=10
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:3000/checkout/return
PAYPAL_CANCEL_URL=http://localhost:3000/checkout/cancel
SPENDWISE_HTTP_CONNECT_TIMEOUT_SECONDS=5
SPENDWISE_HTTP_READ_TIMEOUT_SECONDS=20
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
