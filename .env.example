POSTGRES_DB=spendwise
POSTGRES_USER=spendwise
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

# Backend
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
AUTH_SUCCESS_URL=http://localhost:5173/

# Resend email verification. Add the API key and verified sender when ready.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Integrations: fill locally; never commit real values.
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:5173/checkout/return
PAYPAL_CANCEL_URL=http://localhost:5173/checkout/cancel
PAYPAL_VAULT_RETURN_URL=http://localhost:5173/paypal/vault/return
PAYPAL_VAULT_CANCEL_URL=http://localhost:5173/paypal/vault/cancel
# Generate a private 32-byte key and Base64-encode it; never commit the real key.
PAYPAL_VAULT_ENCRYPTION_KEY=

PAYPAL_WEBHOOK_ID=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Google OAuth 2.0 (register the callback URL as http://localhost:8080/login/oauth2/code/google locally)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
